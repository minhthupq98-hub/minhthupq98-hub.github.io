# Public browser configuration, embedded by Vite at build time.
# Copy to .env.local and set values from the existing Supabase project.
# Use a development project for tests that write data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Never place service_role, secret API keys, account passwords or tokens here.
